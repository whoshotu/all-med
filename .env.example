# ==============================================================================
# MedOps Call Commander — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CALL-E API  ★ REQUIRED ★
#    Get your key at: https://heycall-e.com/developers
#    Format: a long alphanumeric string issued by the CALL-E portal.
# ------------------------------------------------------------------------------
CALLE_API_KEY=

# Optional: override the default CALL-E API endpoint.
# Leave blank to use https://api.heycall-e.com
CALLE_API_BASE_URL=

# Public HTTPS URL that CALL-E will POST call status updates to.
# Use ngrok or your production domain. Must be reachable from the internet.
# Format: https://<your-domain>/calle/webhook
CALLE_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 2. AGY SDK — Google Antigravity Agent  ★ REQUIRED for agy_main.py ★
#    Get your key at: https://aistudio.google.com/app/api-keys
#    Format: AIza followed by a 35-character alphanumeric string.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# TESTING — Your real phone number for end-to-end call testing
#   Set this to your mobile number in E.164 format (+1XXXXXXXXXX).
#   When set, the dashboard will:
#     • Pre-fill the phone field with your number
#     • Show a "🧪 Test Phone Active" badge in the header
#     • Use your number for all quick-trigger preset buttons
#   Leave blank in production — it should never be a patient's real number.
# ------------------------------------------------------------------------------
MEDOPS_TEST_PHONE=

# ------------------------------------------------------------------------------
# 3. EHR ADAPTER  ★ AT LEAST ONE REQUIRED ★
#    OpenDental takes priority if both are set.
#
#  Option A — OpenDental REST API  (https://api.opendental.com/api/v1)
#    OpenDental uses a two-key auth scheme: ODFHIR {DeveloperKey}/{CustomerKey}
#    Required permission: Read All — FREE ($0/location/month)
#      • Patients GET        — fetch patient phone number
#      • PatFields GET       — check automated-call consent field
#    Call outcomes are recorded in the MedOps internal audit log (not written
#    back to OpenDental), so no paid Comm permission is needed.
#
#    OPENDENTAL_API_URL:        Always https://api.opendental.com/api/v1
#
#    OPENDENTAL_DEVELOPER_KEY:  Your company's developer key.
#      → Email vendor.relations@opendental.com with your company name, email,
#        and a description of the integration to receive this key.
#
#    OPENDENTAL_CUSTOMER_KEY:   A per-practice key generated in the Developer Portal.
#      → Log into https://api.opendental.com/portal/gwt/fhirportal.html
#        Click "Add" to generate a key, then paste it into the dental office's
#        Open Dental: Setup > Advanced Setup > API > Add Key
#
#    OPENDENTAL_CONSENT_FIELD:  (optional) Name of the PatField used to store
#      TCPA consent. Default: MEDOPS_CALL_CONSENT
#      → In Open Dental: Setup > Patient Field Defs > Add > name it MEDOPS_CALL_CONSENT
#        Set value to "Y" on each consenting patient's chart.
# ------------------------------------------------------------------------------
OPENDENTAL_API_URL=https://api.opendental.com/api/v1
OPENDENTAL_DEVELOPER_KEY=
OPENDENTAL_CUSTOMER_KEY=
# OPENDENTAL_CONSENT_FIELD=MEDOPS_CALL_CONSENT

#  Option B — FHIR R4 (any FHIR-compliant EHR: Athena, Epic, etc.)
#    FHIR_BASE_URL: your FHIR server base URL, e.g. https://fhir.example.com/r4
#    FHIR_BEARER_TOKEN: OAuth2 bearer token for your FHIR server
FHIR_BASE_URL=
FHIR_BEARER_TOKEN=

# ------------------------------------------------------------------------------
# 4. TELEGRAM HITL GATE  (optional — Web Dashboard works without this)
#    Create a bot via @BotFather on Telegram to get BOT_TOKEN.
#    ADMIN_CHAT_ID: your personal or group chat numeric ID (use @userinfobot).
#    SIGNING_SECRET: a random string you generate for HMAC verification.
#      Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
HITL_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# 5. MCP BRIDGE  (optional — only change if FastAPI runs on a different port)
# ------------------------------------------------------------------------------
# MEDOPS_SERVER_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. CALL-E POLLING TUNING  (optional — production defaults shown)
#    CALLE_POLL_MAX_ATTEMPTS: how many times to poll before marking FAILED (int)
#    CALLE_POLL_INTERVAL: seconds between poll attempts (float)
# ------------------------------------------------------------------------------
# CALLE_POLL_MAX_ATTEMPTS=20
# CALLE_POLL_INTERVAL=3.0
