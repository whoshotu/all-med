# ==============================================================================
# MedOps Call Commander - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CALL-E API (REQUIRED for live calls; demo simulation falls back if offline)
# ------------------------------------------------------------------------------
CALLE_API_KEY=your_calle_api_key_here
CALLE_API_BASE_URL=https://api.heycall-e.com
CALLE_WEBHOOK_URL=https://your-domain.ngrok-free.app/calle/webhook

# ------------------------------------------------------------------------------
# 2. TELEGRAM HITL GATE (OPTIONAL - Web Dashboard supports in-browser approvals)
# ------------------------------------------------------------------------------
# Create a bot via Telegram's @BotFather to get your token:
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_ADMIN_CHAT_ID=987654321
# HITL_SIGNING_SECRET=random_secret_hmac_string_here

# ------------------------------------------------------------------------------
# 3. EHR ADAPTERS (OPTIONAL - Web Dashboard has built-in EHR Simulator)
# ------------------------------------------------------------------------------
# OPENDENTAL_API_URL=https://your-opendental.com/api/v1
# OPENDENTAL_API_KEY=your_opendental_api_key

# FHIR_BASE_URL=https://fhir.your-ehr.com/r4
# FHIR_BEARER_TOKEN=your_fhir_bearer_token
